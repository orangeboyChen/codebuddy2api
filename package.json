{
  "name": "codebuddy2api",
  "version": "1.4.0",
  "private": true,
  "description": "Desktop and self-hosted gateway that proxies CodeBuddy with OpenAI- and Anthropic-compatible APIs.",
  "author": "orangeboyChen",
  "main": "build/electron-app/main.js",
  "scripts": {
    "dev": "next dev",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "docs:preview": "cd docs && bun run preview",
    "prepare": "husky",
    "build": "next build",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test -c playwright.desktop.config.ts",
    "test:e2e:electron": "playwright test -c playwright.electron.config.ts",
    "start": "next start --hostname 0.0.0.0 --port 8001",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "rm -rf .next/types && next typegen && tsc --noEmit",
    "test": "vitest run",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-report.junit.xml",
    "test:coverage": "vitest run --coverage",
    "test:patch-branches": "bun scripts/check-patch-branches.ts",
    "desktop:prepare": "bun scripts/build-desktop.ts --prepare-only",
    "desktop:dist": "bun scripts/build-desktop.ts --dev-icon",
    "desktop:start": "bun run desktop:prepare --dev-icon && electron ."
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@lobehub/fluent-emoji": "^4.1.1",
    "@lobehub/icons": "^5.21.0",
    "@lobehub/ui": "^5.49.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "antd": "^6.6.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "jotai": "^3.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@electron/rebuild": "^4.2.0",
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --check"
    ]
  }
}
