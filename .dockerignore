# Version control and editor metadata
.git
.idea
.venv
.ruff_cache
.vscode

# Python build artifacts, kept from the original Python-era layout
__pycache__/
*/__pycache__/
*.pyc

# Build output and dependencies; node_modules is installed inside the image
.next
node_modules
dist
build

# Test and coverage artifacts
coverage
test-results/
playwright-report/
test-report.junit.xml
*.tsbuildinfo
tsconfig.tsbuildinfo

# VitePress documentation sources; never needed by the app image
docs/

# Local scratch directories
.tmp-*

# Assistant and agent working directories
.agents/
.claude/
.acceptances/

# CI configuration
.github/

# Local runtime data. Baking these into an image would ship credentials.
.codebuddy_data/
.codebuddy_creds/
