# The macOS build.
#
# fastlane builds nothing here — electron-builder does, through
# `bun scripts/build-desktop.ts`, the same command the release workflow's other
# platforms run, and the same one a check on CI runs with `--dev-icon` added.
# What is asked for here is the development icon's absence: `desktop:dev-dist`
# is this build carrying it, and a release is not a development build. What this
# lane adds is the certificate: `match` keeps
# the Developer ID certificate and its private key, encrypted, in a private git
# repository, because CI has no way to make one of its own. So the lane imports
# the certificate into a keychain, points electron-builder at that keychain, and
# gets out of the way.
#
# Without MATCH_GIT_URL it still builds, unsigned, exactly as it did before.

KEYCHAIN_NAME = "codebuddy2api-build"

lane :mac do |options|
  targets = (options[:targets] || "--mac --arm64").split

  if ENV["MATCH_GIT_URL"].to_s.empty?
    UI.important("MATCH_GIT_URL is not set — building without a signing certificate.")
  else
    password = ENV["MATCH_KEYCHAIN_PASSWORD"] || ""

    # A keychain of our own rather than the login keychain: `match` puts the
    # certificate in one place, and electron-builder is told to look there and
    # nowhere else, so it cannot pick up some other identity by accident.
    create_keychain(
      name: KEYCHAIN_NAME,
      password: password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      add_to_search_list: true
    )

    # An https repository and an ssh one are authenticated by different
    # secrets, and `match` picks which by looking at the url. Handing it both
    # breaks the https case: when MATCH_GIT_PRIVATE_KEY is set, match wraps
    # every git command in `ssh-agent bash -c '...'`, and that wrapper is
    # single-quoted — it closes on the quotes match puts around the
    # `http.extraheader='Authorization: Basic …'` it adds for an https url, so
    # the header never reaches git and the clone dies asking for a username.
    # Only the key is dropped: whatever else authenticates the clone — a
    # running ssh-agent, a default key, a credential helper, or credentials of
    # its own in the url — is left to git.
    unless ENV["MATCH_GIT_URL"].to_s.start_with?("git@", "ssh://")
      authorization = ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
      unless authorization.to_s.empty?
        # The header goes on one line, and base64 carries no whitespace: a
        # newline pasted along with the value would make git send a broken
        # Authorization header.
        ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = authorization.gsub(/\s/, "")
      end
      ENV.delete("MATCH_GIT_PRIVATE_KEY")
    end

    # Read-only on purpose: renewing a Developer ID certificate needs the
    # account holder's own login, which CI does not have. It is renewed by
    # hand, when it expires, and pushed back into the repository.
    match(
      type: "developer_id",
      readonly: true,
      keychain_name: KEYCHAIN_NAME,
      keychain_password: password,
      git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"]
    )

    # With no CSC_LINK of its own, electron-builder signs with the identity it
    # finds in CSC_KEYCHAIN.
    ENV["CSC_KEYCHAIN"] = File.expand_path(lane_context[SharedValues::KEYCHAIN_PATH])
  end

  sh("bun", "scripts/build-desktop.ts", *targets)
end
